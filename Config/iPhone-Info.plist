<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>NewMotion</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Pairing uses CryptoKit, which is encryption inside the operating
	     system, so the app is exempt from export filing. Revisit if a
	     non-Apple crypto library is ever linked. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>NSCameraUsageDescription</key>
	<string>NewMotion uses the camera only to scan a one-time pairing QR code.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>NewMotion uses Bluetooth to connect to your Mac.</string>
	<key>NSMotionUsageDescription</key>
	<string>NewMotion uses motion sensors only while you hold Air Mouse.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>NewMotion uses the microphone only while you hold Push to Talk.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>NewMotion turns what you say into text on this iPhone, so your voice never leaves your own devices.</string>
</dict>
</plist>
